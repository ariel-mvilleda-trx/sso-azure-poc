# ============================================
# Azure Entra ID (CIAM) Configuration
# ============================================

# Tenant ID del tenant CIAM
TENANT_ID=69dd60e9-aaaaaaaa-bbbb-cccc-123456789abc

# Client ID de la aplicación API (Resource)
API_CLIENT_ID=fd0c747e-aaaa-bbbb-cccc-123456789abc

# CORS Origins (separadas por comas)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Puerto del servidor API
PORT=8000

# ============================================
# Frontend Configuration (en variables globals)
# ============================================
# Copiar .env.example a .env.local para utilizar en desarrollo

# CLIENT_ID de la aplicación SPA
# CLIENT_ID=806c2125-aaaa-bbbb-cccc-123456789abc

# Base URL de la API para las llamadas del frontend
# API_BASE_URL=http://localhost:8000
